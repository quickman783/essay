__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
build/
dist/
*.egg-info/
.eggs/
.mim/

# ── 工具与编辑器 ───────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db

# ── 日志与临时文件 ─────────────────────────────────────────────
*.log
*.tmp
tmp/

